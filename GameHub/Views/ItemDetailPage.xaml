<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameHub.Views.ItemDetailPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border Style="{StaticResource Card}" HorizontalOptions="Center">
                <Grid WidthRequest="220" HeightRequest="220">
                    <Image Source="{Binding Item.ImageUrl}" Aspect="AspectFit" IsVisible="{Binding Item.HasImage}" />
                    <Label Text="{Binding Item.Game.Emoji}" FontSize="80"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           IsVisible="{Binding Item.NoImage}" />
                </Grid>
            </Border>

            <Label Text="{Binding Item.Title}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Item.Subtitle}" TextColor="Gray" HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8"
                                     BindableLayout.ItemsSource="{Binding Details}"
                                     BindableLayout.ItemTemplate="{StaticResource DetailRowTemplate}" />
            </Border>

            <Button Text="{Binding FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}" />
            <Button Text="{Binding InfoButtonText}" Command="{Binding OpenGameInfoCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
