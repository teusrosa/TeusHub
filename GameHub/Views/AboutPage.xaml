<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameHub.Views.AboutPage"
             Title="Sobre">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="TeusHub" FontSize="26" FontAttributes="Bold" />

            <Label Text="APIs usadas" FontAttributes="Bold" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="🚗 GTA V Data Dumps – veículos (vehicles.json)" />
                    <Label Text="🪂 Fortnite-API – cosméticos e skins" />
                    <Label Text="🔫 CSGO-API (ByMykel) – skins do CS2" />
                    <Label Text="🎮 RAWG – API que relaciona os três jogos (nota, gêneros, plataformas, descrição)" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Como as telas se relacionam" FontAttributes="Bold" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Menu lateral → Início / Jogos / Sobre." />
                    <Label Text="Rodapé (dentro de Jogos) → GTA V, Fortnite, CS2 e Favoritos." />
                    <Label Text="Pilha → lista → detalhe do item → informações do jogo (RAWG) → voltar." />
                    <Label Text="Da tela da RAWG dá para saltar para a aba do jogo (rodapé) ou para o Início (menu lateral)." />
                </VerticalStackLayout>
            </Border>

            <Label Text="Conceitos de POO" FontAttributes="Bold" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Abstração/herança: GameItem → VehicleItem, CosmeticItem, SkinItem, FavoriteItem." />
                    <Label Text="Polimorfismo: as telas usam GameItem; cada subclasse define título, imagem e detalhes." />
                    <Label Text="Interfaces: ICatalogService, IGameInfoService, INavigationService." />
                    <Label Text="Template Method: CachedFileCatalogService&lt;T&gt; (GTA e CS2)." />
                    <Label Text="Encapsulamento e MVVM: BaseViewModel e CatalogViewModel (GTA/Fortnite/CS2)." />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
