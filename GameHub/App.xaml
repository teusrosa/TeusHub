<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameHub.App">
    <Application.Resources>
        <ResourceDictionary>

            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="PrimaryLight">#C9BCF5</Color>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Stroke" Value="#33808080" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1F1F26}" />
            </Style>

            <DataTemplate x:Key="GameItemTemplate">
                <Border Style="{StaticResource Card}" Margin="12,6">
                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                        <Grid WidthRequest="64" HeightRequest="64">
                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" IsVisible="{Binding HasImage}" />
                            <Label Text="{Binding Game.Emoji}" FontSize="32"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding NoImage}" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Badge}" FontSize="11"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="DetailRowTemplate">
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                    <Label Text="{Binding Label}" TextColor="Gray" />
                    <Label Grid.Column="1" Text="{Binding Value}" />
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
